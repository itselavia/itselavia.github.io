{
  "name": "Agentic Jekyll Blog",
  "image": "mcr.microsoft.com/devcontainers/ruby:1-3.2-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.15"
    }
  },
  "forwardPorts": [4000],
  "portsAttributes": {
    "4000": {
      "label": "Jekyll Local Server",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "git config core.hooksPath .githooks && bundle install",
  "customizations": {
    "vscode": {
      "extensions": [
        "rebornix.ruby",
        "yzhang.markdown-all-in-one",
        "ms-python.python"
      ],
      "settings": {
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true
      }
    }
  }
}
