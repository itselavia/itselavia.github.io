# Environment configuration for local Jekyll development and site validation
# Copy to .env if overriding defaults locally (.env is gitignored).

# Jekyll build environment (development | production)
JEKYLL_ENV=development

# Local preview server bind address and port
JEKYLL_HOST=127.0.0.1
JEKYLL_PORT=4000

# Optional: Structured validation log level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO
